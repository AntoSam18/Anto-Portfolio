# Server-only secret. Do not prefix this with VITE_ or expose it in the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Local testing only. This exposes the key in the browser bundle.
VITE_GEMINI_FRONTEND_TEST_MODE=false
VITE_GEMINI_API_KEY=your_gemini_api_key_for_local_testing_only

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
